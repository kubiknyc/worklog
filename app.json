{
  "expo": {
    "name": "WorkLog",
    "slug": "worklog",
    "version": "0.1.0",
    "scheme": "worklog",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.jobsight.worklog",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.jobsight.worklog",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4FC3F7"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#4FC3F7"
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-sqlite",
      "expo-asset",
      [
        "@sentry/react-native",
        {
          "url": "https://sentry.io/",
          "project": "worklog",
          "organization": "site-superhero"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9ce4c9ea-7dba-48e9-ab2d-ce1519f64300"
      }
    },
    "owner": "kubiknyc",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/9ce4c9ea-7dba-48e9-ab2d-ce1519f64300"
    }
  }
}
