{
  "expo": {
    "name": "WorkLog",
    "slug": "worklog",
    "version": "0.1.0",
    "scheme": "worklog",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.jobsight.worklog"
    },
    "android": {
      "package": "com.jobsight.worklog",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      "expo-secure-store",
      "expo-font",
      "expo-sqlite",
      "expo-asset",
      [
        "@sentry/react-native",
        {
          "url": "https://sentry.io/",
          "project": "worklog",
          "organization": "site-superhero"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9ce4c9ea-7dba-48e9-ab2d-ce1519f64300"
      }
    },
    "owner": "kubiknyc",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/9ce4c9ea-7dba-48e9-ab2d-ce1519f64300"
    }
  }
}
