# Local Supabase stack (run `supabase start` in ../jobsight-backend, values from `supabase status`)
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon key from `supabase status`>

# Sentry crash + sync-incident reporting. LEAVE THIS UNSET LOCALLY.
# src/lib/observability is a no-op without it, which is what dev, jest and the
# web export want — setting it here would send your local sync failures to the
# shared project. The real value lives in the EAS `production` environment
# alongside the SENTRY_AUTH_TOKEN secret; see docs/. The DSN itself is a public
# identifier (it can only submit events, never read them), so it is safe in a
# bundle — it is scoped out of dev for noise, not for secrecy.
EXPO_PUBLIC_SENTRY_DSN=
