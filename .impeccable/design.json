  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Full-width 50px accent CTA: sign in, save, next.",
      "html": "<button class=\"ds-btn-primary\">Assign item</button>",
      "css": ".ds-btn-primary{height:50px;width:100%;border:none;border-radius:14px;background:#4FC3F7;color:#06243C;font-family:Archivo, system-ui, sans-serif;font-weight:700;font-size:16px;transition:transform .12s,opacity .12s}.ds-btn-primary:active{transform:scale(.97);opacity:.9}.ds-btn-primary:focus-visible{outline:2px solid #EAF4FF;outline-offset:2px}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Hairline-outlined cancel / secondary action in sheets.",
      "html": "<button class=\"ds-btn-secondary\">Cancel</button>",
      "css": ".ds-btn-secondary{height:50px;width:100%;border:1px solid rgba(120,180,220,0.18);border-radius:14px;background:transparent;color:#EAF4FF;font-family:Archivo, system-ui, sans-serif;font-weight:700;font-size:15px;transition:transform .12s,background .12s}.ds-btn-secondary:hover{background:#0E3252}.ds-btn-secondary:active{transform:scale(.97)}.ds-btn-secondary:focus-visible{outline:2px solid #4FC3F7;outline-offset:2px}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Uppercase label over a 50px hairline field.",
      "html": "<label class=\"ds-field\"><span class=\"ds-field-label\">Email</span><input class=\"ds-input\" placeholder=\"you@company.com\"></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:6px}.ds-field-label{font-family:Archivo, system-ui, sans-serif;font-weight:600;font-size:12px;letter-spacing:.4px;text-transform:uppercase;color:#8FB6D6}.ds-input{height:50px;border-radius:14px;border:1px solid rgba(120,180,220,0.25);background:rgba(255,255,255,0.05);padding:0 14px;color:#EAF4FF;font-family:Archivo, system-ui, sans-serif;font-size:15px;outline:none;transition:border-color .15s}.ds-input::placeholder{color:#5E86A6}.ds-input:focus-visible{border-color:#4FC3F7}"
    },
    {
      "name": "Filter Chips",
      "kind": "chip",
      "refersTo": "filter-chip",
      "description": "Status filter pills on the punch list; active fills with the accent.",
      "html": "<div class=\"ds-chips\"><button class=\"ds-chip ds-chip-active\">All</button><button class=\"ds-chip\">Open</button><button class=\"ds-chip\">Review</button></div>",
      "css": ".ds-chips{display:flex;gap:8px}.ds-chip{border:1px solid rgba(120,180,220,0.18);border-radius:12px;padding:7px 13px;background:transparent;color:#8FB6D6;font-family:Archivo, system-ui, sans-serif;font-weight:600;font-size:13px;cursor:pointer}.ds-chip:hover{color:#EAF4FF}.ds-chip-active{background:#4FC3F7;border-color:#4FC3F7;color:#06243C}.ds-chip:focus-visible{outline:2px solid #4FC3F7;outline-offset:2px}"
    },
    {
      "name": "Status Chip",
      "kind": "chip",
      "refersTo": "status-chip",
      "description": "Status dot on a 13% tint, label in theme text ink (never color alone).",
      "html": "<span class=\"ds-status\"><i class=\"ds-status-dot\"></i>In progress</span>",
      "css": ".ds-status{display:inline-flex;align-items:center;gap:6px;padding:5px 10px;border-radius:999px;background:#8AA6F722;color:#EAF4FF;font-family:Archivo, system-ui, sans-serif;font-weight:600;font-size:12.5px;letter-spacing:.2px}.ds-status-dot{width:7px;height:7px;border-radius:4px;background:#8AA6F7}"
    }
  ],
  "narrative": {
    "northStar": "The Architect's Office",
    "overview": "WorkLog is a professional instrument, not field equipment and not a dashboard. Its world is the drawing set: fine lines, paper and ink, and editorial serif moments. Precision in the details is the premium signal: hairline borders, aligned mono numerals, deliberate whitespace. Gloss, gradients and depth effects are not. The personality is sharp, precise and considered, and the emotional goal is confidence and control.\n\nThe system ships three themes from one token set. **Blueprint** (deep architectural blue, dark) is the default and the site theme: it is the drawing itself. **Editorial** (warm paper, light) and **Béton** (concrete grey, light) suit indoor and office review. Theme choice follows context, never decoration. Every value in `src/theme/tokens.ts` is per-theme and WCAG-verified, so a new color is never a one-theme decision.\n\nThe work happens on a phone, on site, at the end of a shift. Density is \"glanceable first\": a superintendent sees whether today's report is a draft, submitted or locked in under a second. Confirmed anti-references: Procore-style enterprise density; consumer-social playfulness (emoji, bubbly color); generic SaaS (purple gradients, glass cards, cyan-on-dark sparklines); and bare stock UI with no personality.",
    "keyCharacteristics": [
      "Bordered, flat surfaces; depth only where something truly floats.",
      "Spectral serif for signature moments, Archivo sans for all work, JetBrains Mono only where alignment is functional.",
      "One accent per theme, rare and load-bearing.",
      "Status always carried by color **and** a text label.",
      "Token-driven: color, spacing, radii and fonts come from `src/theme`, never hard-coded."
    ],
    "rules": [
      {
        "name": "The Load-Bearing Accent Rule",
        "body": "The theme accent marks the one thing you can act on or the state you're in: primary CTA, active chip, active tab, selection. It never decorates.",
        "section": "colors"
      },
      {
        "name": "The Color-Plus-Word Rule",
        "body": "No status or priority is ever color alone. A chip carries the label in theme text ink; a row bar or dot is backed by the accessibility label.",
        "section": "colors"
      },
      {
        "name": "The Three-Theme Rule",
        "body": "A new color is three colors. Add it to every palette and verify it against that theme's bg, surface and surface2 before shipping.",
        "section": "colors"
      },
      {
        "name": "The Signature Serif Rule",
        "body": "Spectral appears only at moments that matter: wordmark, report title, screen titles, empty-state headline. Never in a button, label, row or field.",
        "section": "typography"
      },
      {
        "name": "The Functional Mono Rule",
        "body": "JetBrains Mono is for identity and alignment (codes, counts), never \"techie\" flavor.",
        "section": "typography"
      },
      {
        "name": "The One Pairing Rule",
        "body": "Any font change is a whole-app decision made once in `src/theme/fonts.ts`. No per-screen fonts.",
        "section": "typography"
      },
      {
        "name": "The Float-Only Shadow Rule",
        "body": "If it doesn't float over content, it has no shadow. Cards, rows, sheets and chips are bordered and flat.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do pull every color, radius, spacing value and font from `src/theme` (`useTheme()`); the pre-auth login's locked Blueprint is the one exception.",
      "Do pair every status or priority color with a label or accessibility text.",
      "Do verify any new color against all three themes' bg, surface and surface2 (AA 4.5:1 for text, 3:1 for indicators).",
      "Do keep motion to transform and opacity on the native driver, with a press-scale on tappables and one staggered reveal per screen at most. Honor reduce-motion.",
      "Do keep tap targets at 44pt minimum and primary controls at 50px.",
      "Do take any new shared token from PunchLog's `src/theme/tokens.ts` first, so the two apps never diverge."
    ],
    "donts": [
      "Don't add drop shadows to cards, rows, chips or sheets; only floating elements cast them.",
      "Don't use gradients, glass, blur effects or decorative sparklines.",
      "Don't set Spectral in UI controls, or JetBrains Mono for anything but codes and counts.",
      "Don't give WorkLog an accent of its own, or use the theme accent for decoration.",
      "Don't put status-colored text on its own status tint; use theme text ink.",
      "Don't pick a WorkLog-only color where a PunchLog token exists.",
      "Don't go below 11px for any UI text."
    ]
  }
}
